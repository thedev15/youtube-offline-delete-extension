{
  "manifest_version": 3,
  "name": "YouTube Offline Remove",
  "version": "0.1.1",
  "description": "Confirm and remove the current offline video through YouTube's Downloads sidebar menu.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["shared.js", "content.js"],
    "run_at": "document_idle"
  }],
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}
}