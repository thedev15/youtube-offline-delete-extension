{
  "manifest_version": 3,
  "name": "YouTube Offline Remove",
  "version": "0.1.5",
  "description": "Experimental confirmed offline removal through YouTube's native download control or Downloads sidebar menu.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["native-control.js"],
    "world": "MAIN",
    "run_at": "document_idle"
  }, {
    "matches": ["https://www.youtube.com/*"],
    "js": ["shared.js", "content.js"],
    "run_at": "document_idle"
  }],
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}
}